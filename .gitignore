.DS_Store

# Konfigurasi deploy per-klien hasil scripts/setup.sh — berisi ID resource
# Cloudflare, dan sengaja tidak dilacak supaya repo tetap identik untuk semua
# klien (lihat komentar di scripts/profile.mjs).
wrangler.generated.toml
wrangler.*.generated.toml

# Profil deployment: satu berkas per klien, berisi domain dan ID resource-nya.
# Pola yang sama menutup deployments/<profil>.secrets.env.
# example.env justru HARUS ikut — itu dokumentasinya.
deployments/*.env
!deployments/example.env
