# ─── Profil deployment ────────────────────────────────────────────────────────
# Satu berkas = satu klien. Salin jadi deployments/<nama>.env, atau biarkan
# ./scripts/setup.sh <nama> yang membuatnya.
#
# Hanya berkas INI yang dilacak git. deployments/*.env lainnya diabaikan, karena
# isinya milik deployment tertentu — bukan bagian dari template.
#
# Nama profil diambil dari nama berkas, dan ikut jadi awalan nama resource
# Cloudflare. Dua klien dalam satu akun tidak bisa punya nama resource yang
# sama, jadi awalan itulah yang memisahkan mereka.

# ─── Wajib diisi ──────────────────────────────────────────────────────────────

# Domain storefront yang dilihat pembeli.
STORE_URL=https://meadza.id

# Domain panel admin.
ADMIN_URL=https://admin.meadza.id

# URL Worker API. Kalau belum pakai domain sendiri, pola bawaan Cloudflare:
#   https://<nama-profil>-api.<subdomain-akun>.workers.dev
API_BASE=https://api.meadza.id

# Pengirim email transaksional (verifikasi, reset password, notifikasi pesanan).
# Domainnya harus sudah terverifikasi di Resend, kalau tidak email tidak terkirim.
EMAIL_FROM_NAME=Meadza
EMAIL_FROM_ADDRESS=noreply@meadza.id

# ─── Opsional ─────────────────────────────────────────────────────────────────
# Semuanya punya nilai turunan yang masuk akal; isi hanya kalau perlu beda.

# Akun Cloudflare tempat deployment ini hidup. Klien boleh menumpang akun agency
# atau punya akunnya sendiri — nama resource sudah diawali nama profil, jadi
# keduanya sama-sama bisa.
#
# Biasanya tidak perlu diisi tangan: setup.sh menyematkannya sendiri saat
# provisioning. Kecuali login wrangler punya akses ke lebih dari satu akun —
# di situ ia berhenti dan meminta nilai ini, karena resource produksi yang
# terlanjur lahir di akun yang salah tidak bisa dipindah, hanya dibuat ulang.
#CLOUDFLARE_ACCOUNT_ID=

# "false" mengarahkan Midtrans ke sandbox. Xendit tidak punya saklar ini —
# ia dibedakan lewat kunci API-nya (test vs live).
#MIDTRANS_IS_PROD=true

# Bawaannya sama dengan STORE_URL. Dipakai untuk menyusun tautan di email.
#APP_URL=https://meadza.id

# Bawaannya STORE_URL + ADMIN_URL. Tambahkan http://localhost:3000 kalau perlu
# menghubungkan dev lokal ke API yang sudah ter-deploy.
#CORS_ORIGINS=https://meadza.id,https://admin.meadza.id

# Nama resource — bawaannya diturunkan dari nama profil. Isi hanya kalau
# resource-nya sudah terlanjur ada dengan nama lain.
#WORKER_NAME=meadza-api
#D1_NAME=meadza-db
#R2_BUCKET=meadza-storage
#QUEUE_NOTIFICATION=meadza-notification-queue
#QUEUE_RESI=meadza-resi-poll-queue
#PAGES_STOREFRONT=meadza-storefront
#PAGES_ADMIN=meadza-admin

# ─── Diisi otomatis oleh setup.sh ─────────────────────────────────────────────
# ID resource hasil provisioning. Jangan diisi manual kecuali memang memindahkan
# deployment ke resource yang sudah ada.

D1_DATABASE_ID=
CART_KV_ID=
SESSION_KV_ID=
CACHE_KV_ID=
